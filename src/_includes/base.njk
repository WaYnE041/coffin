---
title: "LivImagines: {{ title }}"
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>LivImagines: {{ title }}</title>
    <base href="https://livimagines.com/">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Home for the Personal Website of LivImagines">
    
    <link rel="icon" href="images/favicon.png" type="image/x-icon">
    
    <link href="styles/style.css" rel="stylesheet" type="text/css" media="all">
    
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="https://livimagines.com/{{ permalink }}">
    <meta property="og:image" content="https://livimagines.com/images/{{ featured_image }}">
    <meta property="og:description" content="{{ description }}">
  </head>
  
  <body>
    <main id="container">

      {% include "components/header.njk" %}

      <!--This is where the bulk of your page lives-->
      <div id="flex">
        <article>
          <h2>{{ title }}</h2>
          {{ content | safe }}
        </article>
      </div>

    </main>

  </body>
</html>
