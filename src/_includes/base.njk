---
title: "LivImagines: {{ title }}"
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>LivImagines: {{ title }}</title>
    <base href="https://livimagines.com/">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Home for the Personal Website of LivImagines">

    <!--Loads favicon-->
    <link rel="icon" href="images/favicon.png" type="image/x-icon">

    <!--Loads CSS-->
    <link href="styles/style.css" rel="stylesheet" type="text/css" media="all">

    <!--Preloads fonts-->
    <link rel="preload" href="./fonts/SpecialGothicExpandedOne-Regular.ttf" as="font" type="font/ttf" crossorigin/>
    <link rel="preload" href="./fonts/SpecialGothicCondensedOne-Regular.ttf" as="font" type="font/ttf" crossorigin/>
    <link rel="preload" href="./fonts/BebasNeue-Regular.ttf" as="font" type="font/ttf" crossorigin/>
    <link rel="preload" href="./fonts/CalSans-Regular.tff" as="font" type="font/ttf" crossorigin/>

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="https://livimagines.com/{{ permalink }}">
    <meta property="og:image" content="https://livimagines.com/images/{{ featured_image }}">
    <meta property="og:description" content="{{ description }}">
  </head>

  <body>
    <main id="container">

      <header id="headerArea">
        <!--If you wanted to put in a header image, this is where you would do it-->
        <h1>LivImagines</h1>
        <nav id="navbar">
          <!--This is where you edit the navbar links at the top of the page-->
          <ul>
            <li>
              <a href="index.html">Home</a>
            </li>
            <li>
              <a href="gallery.html">Gallery</a>
            </li>
            <li>
              <a href="comms.html">Rates</a>
            </li>
            <li>
              <a href="contact.html">Contact</a>
            </li>
          </ul>

        </nav>
      </header>

      <!--This is where the bulk of your page lives-->
      <div id="flex">
        <article>
          <h2>{{ title }}</h2>
          {{ content | safe }}
        </article>
      </div>

    </main>

  </body>
</html>